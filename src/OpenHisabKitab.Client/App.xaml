<Application x:Class="OpenHisabKitab.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:OpenHisabKitab.Client.Model.Screens;assembly=OpenHisabKitab.Client.Model"
             xmlns:v="clr-namespace:OpenHisabKitab.Client.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- One DataTemplate per screen view model. -->
            <DataTemplate DataType="{x:Type s:HelpViewModel}"><v:HelpView /></DataTemplate>
            <DataTemplate DataType="{x:Type s:DateViewModel}"><v:DateView /></DataTemplate>
            <DataTemplate DataType="{x:Type s:CompanyViewModel}"><v:CompanyView /></DataTemplate>
            <DataTemplate DataType="{x:Type s:SettingsViewModel}"><v:SettingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type s:KeysViewModel}"><v:KeysView /></DataTemplate>
            <DataTemplate DataType="{x:Type s:UsersViewModel}"><v:UsersView /></DataTemplate>
            <DataTemplate DataType="{x:Type s:AccountsViewModel}"><v:AccountsView /></DataTemplate>
            <DataTemplate DataType="{x:Type s:ItemsViewModel}"><v:ItemsView /></DataTemplate>
            <DataTemplate DataType="{x:Type s:PartiesViewModel}"><v:PartiesView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
