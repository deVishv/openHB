<Window x:Class="OpenHisabKitab.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:OpenHisabKitab.Client"
        xmlns:v="clr-namespace:OpenHisabKitab.Client.Views"
        Title="{Binding Title}" Width="1024" Height="768" MinWidth="640" MinHeight="480"
        PreviewKeyDown="OnPreviewKeyDown" PreviewTextInput="OnPreviewTextInput">
    <Window.Resources>
        <v:EnumVisibility x:Key="Shows" />
        <BooleanToVisibilityConverter x:Key="Bool" />
    </Window.Resources>

    <!-- Spec 6.1, top to bottom: menu, prompt, tab strip, content, F key row, status bar. -->
    <Grid>
        <DockPanel x:Name="ShellPanel">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="{t:Txt MenuFile}" AutomationProperties.Name="{t:Name MenuFile}">
                    <MenuItem Header="{t:Txt MenuLogOut}" AutomationProperties.Name="{t:Name MenuLogOut}" Click="OnLogOut" />
                    <MenuItem Header="{t:Txt MenuExit}" AutomationProperties.Name="{t:Name MenuExit}" Click="OnExit" />
                </MenuItem>
                <MenuItem Header="{t:Txt MenuEdit}" AutomationProperties.Name="{t:Name MenuEdit}">
                    <MenuItem x:Name="FindItem" Header="{t:Txt MenuFind}" AutomationProperties.Name="{t:Name MenuFind}" Tag="screen.find" Click="OnCommand" />
                    <MenuItem x:Name="SaveItem" Header="{t:Txt MenuSave}" AutomationProperties.Name="{t:Name MenuSave}" Tag="screen.save" Click="OnCommand" />
                </MenuItem>
                <MenuItem Header="{t:Txt MenuView}" AutomationProperties.Name="{t:Name MenuView}">
                    <MenuItem x:Name="PaletteItem" Header="{t:Txt MenuPalette}" AutomationProperties.Name="{t:Name MenuPalette}" Tag="palette.open" Click="OnCommand" />
                    <MenuItem x:Name="NextItem" Header="{t:Txt MenuNextTab}" AutomationProperties.Name="{t:Name MenuNextTab}" Tag="tab.next" Click="OnCommand" />
                    <MenuItem x:Name="PreviousItem" Header="{t:Txt MenuPreviousTab}" AutomationProperties.Name="{t:Name MenuPreviousTab}" Tag="tab.previous" Click="OnCommand" />
                </MenuItem>
                <MenuItem Header="{t:Txt MenuHelp}" AutomationProperties.Name="{t:Name MenuHelp}">
                    <MenuItem x:Name="HelpItem" Header="{t:Txt MenuFunctions}" AutomationProperties.Name="{t:Name MenuFunctions}" Tag="run.HELP" Click="OnCommand" />
                    <MenuItem x:Name="KeysItem" Header="{t:Txt MenuKeybindings}" AutomationProperties.Name="{t:Name MenuKeybindings}" Tag="run.KEYS" Click="OnCommand" />
                </MenuItem>
            </Menu>

            <DockPanel DockPanel.Dock="Top" Margin="2">
                <TextBlock DockPanel.Dock="Left" Text="&gt;" FontFamily="{DynamicResource NumberFont}" VerticalAlignment="Center" Margin="4,0" />
                <TextBox x:Name="Prompt" Text="{Binding Prompt.Text, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}"
                         AutomationProperties.Name="{t:Name PromptName}" PreviewKeyDown="OnPromptKeyDown" />
            </DockPanel>
            <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=Prompt}" Placement="Bottom" StaysOpen="True" AllowsTransparency="False">
                <ListBox x:Name="SuggestionList" ItemsSource="{Binding Prompt.Suggestions}" SelectedIndex="{Binding Prompt.SelectedSuggestion}"
                         FontFamily="{DynamicResource NumberFont}" Focusable="False" MaxHeight="320" AutomationProperties.Name="{t:Name Suggestions}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Code}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock AutomationProperties.Name="{Binding Code}">
                                <Run Text="{Binding Code, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Name, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Popup>

            <ListBox x:Name="TabStrip" DockPanel.Dock="Top" ItemsSource="{Binding Tabs.Tabs}" SelectedItem="{Binding Tabs.Active}"
                     Background="{DynamicResource FaceBrush}" BorderThickness="0,0,0,1" AutomationProperties.Name="{t:Name TabStrip}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Title}">
                            <TextBlock Text="{Binding Title}" Margin="4,1" />
                            <TextBlock Text="*" Visibility="{Binding Changed, Converter={StaticResource Bool}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StatusBar DockPanel.Dock="Bottom" AutomationProperties.Name="{t:Name StatusBar}">
                <StatusBarItem>
                    <TextBlock x:Name="StatusMessage" Text="{Binding Status.Message}" AutomationProperties.LiveSetting="Polite" />
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{t:Txt ChangedMarker}" Margin="8,0" FontWeight="Bold"
                                   Visibility="{Binding Status.Changed, Converter={StaticResource Bool}}" />
                        <TextBlock Text="{Binding Status.WorkingDate}" Margin="8,0" />
                        <TextBlock Text="{Binding Status.Connection}" Margin="8,0" />
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>

            <ItemsControl x:Name="FKeyRow" DockPanel.Dock="Bottom" ItemsSource="{Binding FKeys}" AutomationProperties.Name="{t:Name FKeys}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" Columns="12" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Text}" AutomationProperties.Name="{Binding Text}" Padding="2" Focusable="False" Click="OnFKey" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ContentControl x:Name="ScreenHost" Content="{Binding Tabs.Active.Screen}" Focusable="False" Margin="4"
                            AutomationProperties.Name="{t:Name Content}" />
        </DockPanel>

        <v:SessionView DataContext="{Binding Session}" Visibility="{Binding Panel, Converter={StaticResource Shows}, ConverterParameter=!None}" />

        <Border x:Name="PaletteOverlay" Visibility="{Binding Palette.IsOpen, Converter={StaticResource Bool}}" VerticalAlignment="Top"
                HorizontalAlignment="Center" Margin="0,48,0,0" Width="560" Background="{DynamicResource FaceBrush}"
                BorderBrush="{DynamicResource DarkShadowBrush}" BorderThickness="1" Padding="6" AutomationProperties.Name="{t:Name Palette}">
            <StackPanel>
                <TextBox x:Name="PaletteSearch" Text="{Binding Palette.Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{t:Name PaletteSearch}"
                         PreviewKeyDown="OnPaletteKeyDown" />
                <ListBox ItemsSource="{Binding Palette.Items}" SelectedIndex="{Binding Palette.Selected}" DisplayMemberPath="Label" MaxHeight="360"
                         Focusable="False" AutomationProperties.Name="{t:Name PaletteItems}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</Window>
