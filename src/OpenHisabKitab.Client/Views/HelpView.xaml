<UserControl x:Class="OpenHisabKitab.Client.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:OpenHisabKitab.Client"
             xmlns:v="clr-namespace:OpenHisabKitab.Client.Views">
    <UserControl.Resources>
        <v:PresentVisibility x:Key="Present" />
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <Label Content="{t:Txt HelpFilter}" Target="{Binding ElementName=FilterBox}" />
            <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{t:Name HelpFilter}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Margin="2" Visibility="{Binding Message, Converter={StaticResource Present}}"
                   AutomationProperties.LiveSetting="Polite" />
        <Border DockPanel.Dock="Top" Margin="2" Padding="6" BorderThickness="1" BorderBrush="{DynamicResource DarkShadowBrush}"
                Background="{DynamicResource ContentBrush}" Visibility="{Binding One, Converter={StaticResource Present}}">
            <StackPanel>
                <TextBlock FontWeight="Bold" Foreground="{DynamicResource ContentTextBrush}">
                    <Run Text="{Binding One.Code, Mode=OneWay}" FontFamily="{DynamicResource NumberFont}" /><Run Text="  " /><Run Text="{Binding One.Name, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding One.Purpose}" TextWrapping="Wrap" Foreground="{DynamicResource ContentTextBrush}" />
                <TextBlock Text="{Binding One.Key}" FontFamily="{DynamicResource NumberFont}" Foreground="{DynamicResource ContentTextBrush}" />
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <DockPanel Margin="2">
                <TextBlock DockPanel.Dock="Top" Text="{t:Txt HelpFunctions}" FontWeight="Bold" />
                <ListView ItemsSource="{Binding Functions}" AutomationProperties.Name="{t:Name HelpFunctions}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{t:Txt CodeColumn}" DisplayMemberBinding="{Binding Code}" Width="70" />
                            <GridViewColumn Header="{t:Txt NameColumn}" DisplayMemberBinding="{Binding Name}" Width="180" />
                            <GridViewColumn Header="{t:Txt CategoryColumn}" DisplayMemberBinding="{Binding Category}" Width="100" />
                            <GridViewColumn Header="{t:Txt KeyColumn}" DisplayMemberBinding="{Binding Key}" Width="90" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="2">
                <TextBlock DockPanel.Dock="Top" Text="{t:Txt HelpShortcuts}" FontWeight="Bold" />
                <ListView ItemsSource="{Binding Shortcuts}" AutomationProperties.Name="{t:Name HelpShortcuts}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Command}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{t:Txt KeyColumn}" DisplayMemberBinding="{Binding Key}" Width="120" />
                            <GridViewColumn Header="{t:Txt CommandColumn}" DisplayMemberBinding="{Binding Command}" Width="200" />
                            <GridViewColumn Header="{t:Txt WhenColumn}" DisplayMemberBinding="{Binding When}" Width="120" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
