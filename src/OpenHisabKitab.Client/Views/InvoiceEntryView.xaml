<UserControl x:Class="OpenHisabKitab.Client.Views.InvoiceEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:OpenHisabKitab.Client"
             xmlns:v="clr-namespace:OpenHisabKitab.Client.Views">
    <UserControl.Resources>
        <v:PresentVisibility x:Key="Present" />
        <BooleanToVisibilityConverter x:Key="Bool" />
    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Margin="2" TextWrapping="Wrap"
                       Visibility="{Binding Message, Converter={StaticResource Present}}" AutomationProperties.LiveSetting="Assertive" />
            <TextBlock DockPanel.Dock="Top" Text="{t:Txt CancelledMarker}" Margin="2" FontWeight="Bold" Visibility="{Binding IsCancelled, Converter={StaticResource Bool}}" />

            <!-- Header (spec 6.4): party, place of supply, kind or direction, supplier's document, original invoice, export details. -->
            <WrapPanel DockPanel.Dock="Top" Margin="2" Orientation="Horizontal">
                <StackPanel Margin="0,0,8,0" Width="110">
                    <Label Content="{t:Txt VoucherDateLabel}" Target="{Binding ElementName=VoucherDate}" />
                    <TextBox x:Name="VoucherDate" Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}"
                             AutomationProperties.Name="{t:Name VoucherDateLabel}" />
                </StackPanel>
                <StackPanel Margin="0,0,8,0" Width="240">
                    <Label Content="{t:Txt PartyLabel}" Target="{Binding ElementName=Party}" />
                    <v:LookupBox x:Name="Party" DataContext="{Binding Party}" AutomationName="{t:Name PartyLabel}" CreateRequested="OnCreateParty" />
                </StackPanel>
                <StackPanel Margin="0,0,8,0" Width="200" Visibility="{Binding ShowsTax, Converter={StaticResource Bool}}">
                    <Label Content="{t:Txt PlaceOfSupplyLabel}" Target="{Binding ElementName=Pos}" />
                    <ComboBox x:Name="Pos" ItemsSource="{Binding States}" SelectedItem="{Binding PlaceOfSupply}" DisplayMemberPath="Label"
                              AutomationProperties.Name="{t:Name PlaceOfSupplyLabel}" />
                </StackPanel>
                <StackPanel Margin="0,0,8,0" Width="140" Visibility="{Binding IsNote, Converter={StaticResource Bool}}">
                    <Label Content="{t:Txt DirectionLabel}" Target="{Binding ElementName=Dir}" />
                    <ComboBox x:Name="Dir" ItemsSource="{Binding DirectionOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Direction}" AutomationProperties.Name="{t:Name DirectionLabel}" />
                </StackPanel>
                <StackPanel Margin="0,0,8,0" Width="160" Visibility="{Binding ShowsKind, Converter={StaticResource Bool}}">
                    <Label Content="{t:Txt KindLabel}" Target="{Binding ElementName=KindBox}" />
                    <ComboBox x:Name="KindBox" ItemsSource="{Binding KindOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Kind}" AutomationProperties.Name="{t:Name KindLabel}" />
                </StackPanel>
                <CheckBox Content="{t:Txt ReverseChargeLabel}" IsChecked="{Binding ReverseCharge}" VerticalAlignment="Bottom" Margin="0,0,8,4"
                          AutomationProperties.Name="{t:Name ReverseChargeLabel}" Visibility="{Binding ShowsReverseCharge, Converter={StaticResource Bool}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsPartyDoc, Converter={StaticResource Bool}}">
                    <StackPanel Margin="0,0,8,0" Width="140">
                        <Label Content="{t:Txt PartyDocNumberLabel}" Target="{Binding ElementName=Pdn}" />
                        <TextBox x:Name="Pdn" Text="{Binding PartyDocNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{t:Name PartyDocNumberLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0" Width="110">
                        <Label Content="{t:Txt PartyDocDateLabel}" Target="{Binding ElementName=Pdd}" />
                        <TextBox x:Name="Pdd" Text="{Binding PartyDocDate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}"
                                 AutomationProperties.Name="{t:Name PartyDocDateLabel}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsNote, Converter={StaticResource Bool}}">
                    <StackPanel Margin="0,0,8,0" Width="150">
                        <Label Content="{t:Txt OriginalNumberLabel}" Target="{Binding ElementName=Orig}" />
                        <TextBox x:Name="Orig" Text="{Binding OriginalNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{t:Name OriginalNumberLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0" Width="110">
                        <Label Content="{t:Txt OriginalDateLabel}" Target="{Binding ElementName=OrigDate}" />
                        <TextBox x:Name="OrigDate" Text="{Binding OriginalDate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}"
                                 AutomationProperties.Name="{t:Name OriginalDateLabel}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsExport, Converter={StaticResource Bool}}">
                    <StackPanel Margin="0,0,8,0" Width="90">
                        <Label Content="{t:Txt PortCodeLabel}" Target="{Binding ElementName=Port}" />
                        <TextBox x:Name="Port" Text="{Binding PortCode, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" AutomationProperties.Name="{t:Name PortCodeLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0" Width="110">
                        <Label Content="{t:Txt ShippingBillNumberLabel}" Target="{Binding ElementName=Sbn}" />
                        <TextBox x:Name="Sbn" Text="{Binding ShippingBillNumber, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}"
                                 AutomationProperties.Name="{t:Name ShippingBillNumberLabel}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0" Width="110">
                        <Label Content="{t:Txt ShippingBillDateLabel}" Target="{Binding ElementName=Sbd}" />
                        <TextBox x:Name="Sbd" Text="{Binding ShippingBillDate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}"
                                 AutomationProperties.Name="{t:Name ShippingBillDateLabel}" />
                    </StackPanel>
                </StackPanel>
            </WrapPanel>

            <!-- In reading order, so Tab goes from the header into the lines and reaches the footer last (spec 6.4). -->
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="2,6,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{t:Txt ItemColumn}" />
                    <TextBlock Grid.Column="1" Text="{t:Txt LedgerColumn}" />
                    <TextBlock Grid.Column="2" Text="{t:Txt DescriptionColumn}" />
                    <TextBlock Grid.Column="3" Text="{t:Txt HsnColumn}" />
                    <TextBlock Grid.Column="4" Text="{t:Txt QuantityColumn}" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="{t:Txt PriceColumn}" TextAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="{t:Txt DiscountColumn}" TextAlignment="Right" />
                    <TextBlock Grid.Column="7" Text="{t:Txt RateColumn}" TextAlignment="Right" />
                    <TextBlock Grid.Column="8" Text="{t:Txt CessColumn}" TextAlignment="Right" />
                    <TextBlock Grid.Column="9" Text="{t:Txt TaxIncludedColumn}" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="Lines" ItemsSource="{Binding Lines}" v:EntryGrid.IsEntryGrid="True" Focusable="False"
                                  AutomationProperties.Name="{t:Name ItemColumn}" IsEnabled="{Binding IsCancelled, Converter={x:Static v:Negate.Instance}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <v:LookupBox DataContext="{Binding Item}" AutomationName="{t:Name ItemColumn}" />
                                    <v:LookupBox Grid.Column="1" DataContext="{Binding Ledger}" AutomationName="{t:Name LedgerColumn}" />
                                    <TextBox Grid.Column="2" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{t:Name DescriptionColumn}" />
                                    <TextBox Grid.Column="3" Text="{Binding HsnSac, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}" AutomationProperties.Name="{t:Name HsnColumn}" />
                                    <TextBox Grid.Column="4" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}" TextAlignment="Right" AutomationProperties.Name="{t:Name QuantityColumn}" />
                                    <TextBox Grid.Column="5" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}" TextAlignment="Right" AutomationProperties.Name="{t:Name PriceColumn}"
                                             LostKeyboardFocus="OnAmountCommitted" />
                                    <TextBox Grid.Column="6" Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}" TextAlignment="Right" AutomationProperties.Name="{t:Name DiscountColumn}" />
                                    <TextBox Grid.Column="7" Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}" TextAlignment="Right" AutomationProperties.Name="{t:Name RateColumn}" />
                                    <TextBox Grid.Column="8" Text="{Binding Cess, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}" TextAlignment="Right" AutomationProperties.Name="{t:Name CessColumn}" />
                                    <CheckBox Grid.Column="9" IsChecked="{Binding PriceIncludesTax}" VerticalAlignment="Center" Margin="4,0" AutomationProperties.Name="{t:Name TaxIncludedColumn}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- Footer: live taxable value, each tax in use, round off, total; a line problem in the host's words. -->
                <StackPanel Grid.Row="2" Margin="2">
                    <DockPanel>
                        <Label DockPanel.Dock="Left" Content="{t:Txt NarrationLabel}" Target="{Binding ElementName=Narration}" />
                        <TextBox x:Name="Narration" Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{t:Name NarrationLabel}" />
                    </DockPanel>
                    <TextBlock Text="{Binding AllocationText}" FontFamily="{DynamicResource NumberFont}" Visibility="{Binding AllocationText, Converter={StaticResource Present}}" />
                    <TextBlock Text="{Binding Difference}" FontWeight="Bold" Visibility="{Binding Difference, Converter={StaticResource Present}}" AutomationProperties.LiveSetting="Polite" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="{t:Txt SaveRecordButton}" AutomationProperties.Name="{t:Name SaveRecordButton}" Click="OnSave" />
                            <Button Content="{t:Txt BillsButton}" AutomationProperties.Name="{t:Name BillsButton}" Click="OnBills" Margin="4,0,0,0"
                                    Visibility="{Binding IsNote, Converter={StaticResource Bool}}" />
                            <Button Content="{t:Txt CancelVoucherButton}" AutomationProperties.Name="{t:Name CancelVoucherButton}" Click="OnCancelVoucher" Margin="4,0,0,0"
                                    Visibility="{Binding IsEditing, Converter={StaticResource Bool}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Totals}" FontFamily="{DynamicResource NumberFont}" TextAlignment="Right" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </DockPanel>

        <ContentControl Content="{Binding SubScreen}" Visibility="{Binding SubScreen, Converter={StaticResource Present}}" Background="{DynamicResource FaceBrush}"
                        Margin="24" Focusable="False" />
        <ContentControl Content="{Binding Bills}" Visibility="{Binding Bills, Converter={StaticResource Present}}" Margin="48,48,48,0"
                        VerticalAlignment="Top" Focusable="False" />
    </Grid>
</UserControl>
