<UserControl x:Class="OpenHisabKitab.Client.Views.JournalEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:OpenHisabKitab.Client"
             xmlns:v="clr-namespace:OpenHisabKitab.Client.Views">
    <UserControl.Resources>
        <v:PresentVisibility x:Key="Present" />
        <BooleanToVisibilityConverter x:Key="Bool" />
    </UserControl.Resources>
    <Grid>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Margin="2" TextWrapping="Wrap"
                       Visibility="{Binding Message, Converter={StaticResource Present}}" AutomationProperties.LiveSetting="Assertive" />
            <TextBlock DockPanel.Dock="Top" Text="{t:Txt CancelledMarker}" Margin="2" FontWeight="Bold"
                       Visibility="{Binding IsCancelled, Converter={StaticResource Bool}}" />

            <!-- Header: date, the account for RCPT and PYMT, narration. -->
            <Grid DockPanel.Dock="Top" Margin="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <Label Content="{t:Txt VoucherDateLabel}" Target="{Binding ElementName=VoucherDate}" />
                <TextBox x:Name="VoucherDate" Grid.Column="1" Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}"
                         AutomationProperties.Name="{t:Name VoucherDateLabel}" />
                <Label Grid.Column="2" Content="{Binding AccountLabel}" Target="{Binding ElementName=Account}"
                       Visibility="{Binding HasAccount, Converter={StaticResource Bool}}" />
                <v:LookupBox x:Name="Account" Grid.Column="3" DataContext="{Binding Account}" AutomationName="{Binding DataContext.AccountLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Visibility="{Binding DataContext.HasAccount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Bool}}" />
                <Label Grid.Row="1" Content="{t:Txt NarrationLabel}" Target="{Binding ElementName=Narration}" />
                <TextBox x:Name="Narration" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Narration, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{t:Name NarrationLabel}" />
            </Grid>

            <!-- In reading order, so Tab goes from the header into the lines and reaches the footer last (spec 6.4). -->
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="2,6,2,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{t:Txt LedgerColumn}" />
                    <TextBlock Grid.Column="1" Text="{t:Txt AmountColumn}" TextAlignment="Right" Visibility="{Binding HasAccount, Converter={StaticResource Bool}}" />
                    <TextBlock Grid.Column="1" Text="{t:Txt DebitColumn}" TextAlignment="Right" Visibility="{Binding HasDebitCredit, Converter={StaticResource Bool}}" />
                    <TextBlock Grid.Column="2" Text="{t:Txt CreditColumn}" TextAlignment="Right" Visibility="{Binding HasDebitCredit, Converter={StaticResource Bool}}" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="Lines" ItemsSource="{Binding Lines}" v:EntryGrid.IsEntryGrid="True" Focusable="False"
                                  AutomationProperties.Name="{t:Name LedgerColumn}" IsEnabled="{Binding IsCancelled, Converter={x:Static v:Negate.Instance}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <v:LookupBox DataContext="{Binding Ledger}" AutomationName="{t:Name LedgerColumn}" CreateRequested="OnCreateParty" />
                                        <TextBox Grid.Column="1" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}" TextAlignment="Right"
                                                 AutomationProperties.Name="{t:Name AmountColumn}" LostKeyboardFocus="OnAmountCommitted"
                                                 Visibility="{Binding DataContext.HasAccount, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Bool}}" />
                                        <TextBox Grid.Column="1" Text="{Binding Debit, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}" TextAlignment="Right"
                                                 AutomationProperties.Name="{t:Name DebitColumn}"
                                                 Visibility="{Binding DataContext.HasDebitCredit, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Bool}}" />
                                        <TextBox Grid.Column="2" Text="{Binding Credit, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}" TextAlignment="Right"
                                                 AutomationProperties.Name="{t:Name CreditColumn}"
                                                 Visibility="{Binding DataContext.HasDebitCredit, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Bool}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding AllocationText}" FontFamily="{DynamicResource NumberFont}" Margin="12,0,0,2"
                                               Visibility="{Binding AllocationText, Converter={StaticResource Present}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- Footer: live totals and the difference until it reaches zero (spec 6.4). -->
                <DockPanel Grid.Row="2" Margin="2">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="{t:Txt SaveRecordButton}" AutomationProperties.Name="{t:Name SaveRecordButton}" Click="OnSave" />
                        <Button Content="{t:Txt BillsButton}" AutomationProperties.Name="{t:Name BillsButton}" Click="OnBills" Margin="4,0,0,0"
                                Visibility="{Binding HasAccount, Converter={StaticResource Bool}}" />
                        <Button Content="{t:Txt CancelVoucherButton}" AutomationProperties.Name="{t:Name CancelVoucherButton}" Click="OnCancelVoucher" Margin="4,0,0,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource Bool}}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Difference}" FontFamily="{DynamicResource NumberFont}" FontWeight="Bold" Margin="12,0,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding Totals}" FontFamily="{DynamicResource NumberFont}" TextAlignment="Right" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </Grid>
        </DockPanel>

        <!-- Sub screens over the voucher: a new party (PRTY), or the bills of a line's party. Esc returns. -->
        <ContentControl Content="{Binding SubScreen}" Visibility="{Binding SubScreen, Converter={StaticResource Present}}" Background="{DynamicResource FaceBrush}"
                        Margin="24" Focusable="False" />
        <ContentControl Content="{Binding Bills}" Visibility="{Binding Bills, Converter={StaticResource Present}}" Margin="48,48,48,0"
                        VerticalAlignment="Top" Focusable="False" />
    </Grid>
</UserControl>
