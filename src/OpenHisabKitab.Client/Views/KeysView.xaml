<UserControl x:Class="OpenHisabKitab.Client.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:OpenHisabKitab.Client"
             xmlns:v="clr-namespace:OpenHisabKitab.Client.Views">
    <UserControl.Resources>
        <v:PresentVisibility x:Key="Present" />
        <v:EnumVisibility x:Key="Shows" />
        <v:LayerName x:Key="LayerName" />
        <BooleanToVisibilityConverter x:Key="Bool" />
        <DataTemplate x:Key="LayerItem">
            <TextBlock Text="{Binding Converter={StaticResource LayerName}}" />
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <CheckBox DockPanel.Dock="Right" Content="{t:Txt JsonModeLabel}" IsChecked="{Binding JsonMode}" AutomationProperties.Name="{t:Name JsonModeLabel}"
                      VerticalAlignment="Center" />
            <Label Content="{t:Txt SettingsFilter}" Target="{Binding ElementName=FilterBox}" />
            <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{t:Name SettingsFilter}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Margin="2" Visibility="{Binding Message, Converter={StaticResource Present}}"
                   AutomationProperties.LiveSetting="Assertive" />
        <Grid>
            <!-- Form mode: Enter on a row records its new key; Delete resets it. -->
            <DockPanel Visibility="{Binding JsonMode, Converter={StaticResource Shows}, ConverterParameter=False}">
                <DockPanel DockPanel.Dock="Bottom">
                    <Button DockPanel.Dock="Right" Content="{t:Txt ResetButton}" AutomationProperties.Name="{t:Name ResetButton}" Click="OnReset" />
                    <Button DockPanel.Dock="Right" Content="{t:Txt RecordButton}" AutomationProperties.Name="{t:Name RecordButton}" Click="OnRecord" />
                    <Label Content="{t:Txt LayerLabel}" Target="{Binding ElementName=TargetBox}" />
                    <ComboBox x:Name="TargetBox" ItemsSource="{Binding Layers}" SelectedItem="{Binding TargetLayer}" ItemTemplate="{StaticResource LayerItem}"
                              HorizontalAlignment="Left" MinWidth="110" AutomationProperties.Name="{t:Name LayerLabel}" />
                </DockPanel>
                <ListView x:Name="KeyList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{t:Name MenuKeybindings}"
                          KeyDown="OnListKeyDown">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem"><Setter Property="AutomationProperties.Name" Value="{Binding CommandName}" /></Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{t:Txt KeyColumnHeader}" DisplayMemberBinding="{Binding Key}" Width="130" />
                            <GridViewColumn Header="{t:Txt CommandColumn}" DisplayMemberBinding="{Binding CommandName}" Width="220" />
                            <GridViewColumn Header="{t:Txt WhenColumn}" DisplayMemberBinding="{Binding When}" Width="150" />
                            <GridViewColumn Header="{t:Txt FromColumn}" DisplayMemberBinding="{Binding FromText}" Width="90" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <!-- JSON mode: one layer's keybindings.json; Ctrl+S saves it. -->
            <DockPanel Visibility="{Binding JsonMode, Converter={StaticResource Bool}}">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="{t:Txt SaveButton}" AutomationProperties.Name="{t:Name SaveButton}" Click="OnSaveJson" />
                    <Label Content="{t:Txt LayerLabel}" Target="{Binding ElementName=JsonLayerBox}" />
                    <ComboBox x:Name="JsonLayerBox" ItemsSource="{Binding Layers}" SelectedItem="{Binding JsonLayer}" ItemTemplate="{StaticResource LayerItem}"
                              HorizontalAlignment="Left" MinWidth="110" AutomationProperties.Name="{t:Name LayerLabel}" />
                </DockPanel>
                <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding JsonErrors}" MaxHeight="120" AutomationProperties.Name="{t:Name Errors}" />
                <TextBox Text="{Binding JsonText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontFamily="{DynamicResource NumberFont}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{t:Name JsonModeLabel}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
