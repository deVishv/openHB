<UserControl x:Class="OpenHisabKitab.Client.Views.LockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:OpenHisabKitab.Client"
             xmlns:v="clr-namespace:OpenHisabKitab.Client.Views">
    <UserControl.Resources>
        <v:PresentVisibility x:Key="Present" />
        <BooleanToVisibilityConverter x:Key="Bool" />
    </UserControl.Resources>
    <StackPanel Margin="4" HorizontalAlignment="Left" MinWidth="360">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Visibility="{Binding Message, Converter={StaticResource Present}}"
                   AutomationProperties.LiveSetting="Assertive" />
        <TextBlock Text="{t:Txt LockHeading}" FontWeight="Bold" />
        <TextBlock Text="{Binding Current}" FontFamily="{DynamicResource NumberFont}" Margin="0,4" AutomationProperties.LiveSetting="Polite" />
        <DockPanel IsEnabled="{Binding CanLock}">
            <Label DockPanel.Dock="Left" Content="{t:Txt LockDateLabel}" Target="{Binding ElementName=NewDate}" />
            <Button DockPanel.Dock="Right" Content="{t:Txt LockButton}" AutomationProperties.Name="{t:Name LockButton}" Click="OnLock" />
            <TextBox x:Name="NewDate" Text="{Binding NewDate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource NumberFont}"
                     AutomationProperties.Name="{t:Name LockDateLabel}" />
        </DockPanel>
        <Button HorizontalAlignment="Left" Margin="0,8,0,0" Content="{t:Txt UnlockButton}" AutomationProperties.Name="{t:Name UnlockButton}" Click="OnUnlock"
                Visibility="{Binding CanUnlock, Converter={StaticResource Bool}}" />
    </StackPanel>
</UserControl>
